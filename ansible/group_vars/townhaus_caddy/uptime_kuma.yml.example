# Uptime Kuma API connection — port 3001 must be reachable from your control machine.
uptime_kuma_api_url: http://192.168.2.151:3010

# 1Password refs — item named 'Uptime' in the Homelab vault.
uptime_kuma_user_ref: op://Homelab/Uptime/username
uptime_kuma_pass_ref: op://Homelab/Uptime/password

# Status page
uptime_kuma_status_page:
  slug: townhaus
  title: Townhaus
  description: Homelab service status
  theme: auto
  published: true
  groups:
    - name: Beelink
      weight: 1
      monitorList:
        - name: Immich
        - name: AdGuard
        - name: Beszel
        - name: Frigate
        - name: Groovenet
        - name: Groovenet backup
        - name: Home Assistant
    - name: Audio
      weight: 2
      monitorList:
        - name: aswitch
        - name: pi-cam
        - name: Vinyl Live

# Home Assistant notification — set to your HA LAN URL and 1Password ref.
uptime_kuma_ha_url: http://192.168.1.x:8123
uptime_kuma_ha_token_ref: op://Homelab/HomeAssistantNotifier/token

# Monitors to remove — add names here when retiring a monitor.
uptime_kuma_monitors_absent:
  - Scrypted

# Monitors — URLs are checked from within the Uptime Kuma container.
# Use Docker service names for co-located containers on shared Docker networks,
# LAN IPs for everything else.
uptime_kuma_monitors:
  - name: Immich
    url: http://immich-server:2283
  - name: AdGuard
    url: http://adguardhome:80
  - name: Beszel
    url: http://192.168.2.151:8090
  - name: Frigate
    url: http://192.168.2.151:5000
  - name: Groovenet
    url: http://webapp:3000
  - name: Groovenet backup
    # A keyword monitor avoids Kuma v2's JSON-query condition API while still
    # requiring the endpoint's own freshness assessment.
    type: keyword
    url: http://webapp:3000/api/health/backup
    keyword: '"healthy":true'
    interval: 3600
  - name: Home Assistant
    url: http://192.168.1.x:8123
  - name: aswitch
    type: ping
    hostname: 192.168.2.170
  - name: pi-cam
    url: http://192.168.2.171:5005/gui/index.html
  - name: Vinyl Live
    # Checks the public listener's health endpoint, which proxies to the
    # controller and fails if the audio service is unavailable.
    url: http://192.168.2.151:8098/healthz
