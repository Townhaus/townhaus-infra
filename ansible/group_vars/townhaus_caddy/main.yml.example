townhaus_caddy_app_dir: /srv/docker/townhaus-caddy
townhaus_caddy_owner: saegey
townhaus_caddy_group: saegey

dotfiles_enabled: false

townhaus_caddy_compose_project_name: townhaus-caddy
townhaus_caddy_pull_images: true
townhaus_caddy_uptime_kuma_backup_dir: /srv/storage/uptime-kuma-backups

# Required: 1Password secret reference resolved locally with `op read`.
# Example: op://Homelab/Immich Database/password
# Replace this placeholder before running the playbook.
townhaus_caddy_immich_db_password_ref: op://Vault/Item/field

# Required: 1Password secret reference for Grafana's initial admin password.
townhaus_caddy_grafana_admin_password_ref: op://Homelab/Grafana/password

nfs_music_path: /srv/music
nfs_allowed_networks:
  - 192.168.2.0/24
  - 100.64.0.0/10

# Samba login for the archive share. Store its password in 1Password and
# replace this reference before deploying the Beelink playbook.
samba_archive_user: saegey
samba_archive_path: /srv/storage/archive
samba_archive_password_ref: op://Vault/Archive SMB/password
samba_archive_allowed_networks:
  - 192.168.2.0/24
  - 100.64.0.0/10

townhaus_caddy_env:
  CADDY_HTTP_PORT: "80"
  CADDY_HTTPS_PORT: "443"
  GROOVENET_DOCKER_NETWORK: dj-playlist_default
  GROOVENET_UPSTREAM_HOST: webapp
  TZ: America/Los_Angeles

  ADGUARD_DNS_PORT: "53"
  ADGUARD_ADMIN_PORT: "3001"
  ADGUARD_WEB_PORT: "3080"

  IMMICH_UPLOAD_LOCATION: /srv/storage/immich/library
  IMMICH_DB_DATA_LOCATION: /srv/docker/townhaus-caddy/data/immich/postgres
  IMMICH_DB_HOSTNAME: immich-database
  IMMICH_DB_PORT: "5432"
  IMMICH_DB_PASSWORD: "{{ townhaus_caddy_immich_db_password }}"
  IMMICH_DB_USERNAME: postgres
  IMMICH_DB_DATABASE_NAME: immich
  IMMICH_REDIS_HOSTNAME: immich-redis
  IMMICH_REDIS_PORT: "6379"
  GRAFANA_ADMIN_PASSWORD: "{{ townhaus_caddy_grafana_admin_password }}"
