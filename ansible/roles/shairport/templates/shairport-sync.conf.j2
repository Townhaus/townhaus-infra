// Managed by Ansible – edit in ansible/roles/shairport/templates/ in the monorepo.

general = {
  name = "{{ shairport_name }}";
  interpolation = "{{ shairport_interpolation }}";
  output_backend = "{{ shairport_output_backend }}";
  // Use the configured software or hardware mixer policy for AirPlay volume.
  ignore_volume_control = "{{ shairport_ignore_volume_control }}";
{% if shairport_volume_max_db is defined %}
  volume_max_db = {{ shairport_volume_max_db }};
{% endif %}
};

alsa = {
  output_device = "{{ shairport_alsa_output }}";
{% if shairport_alsa_output_rate is defined %}
  output_rate = {{ shairport_alsa_output_rate }};
{% endif %}
{% if shairport_alsa_output_format is defined %}
  output_format = "{{ shairport_alsa_output_format }}";
{% endif %}
};

mqtt = {
  enabled = "{{ shairport_mqtt_enabled }}";
  hostname = "{{ mqtt_host }}";
  port = {{ mqtt_port }};
  topic = "{{ shairport_mqtt_topic }}";
  username = "{{ shairport_mqtt_user }}";
  password = "{{ shairport_mqtt_pass }}";
{% if shairport_mqtt_client_id is defined %}
  client_id = "{{ shairport_mqtt_client_id }}";
{% endif %}
  publish_parsed = "{{ shairport_mqtt_publish_parsed | default('no') }}";
  publish_cover = "{{ shairport_mqtt_publish_cover | default('no') }}";
{% if shairport_mqtt_enable_remote is defined %}
  enable_remote = "{{ shairport_mqtt_enable_remote }}";
{% endif %}
};

metadata = {
  enabled = "{{ shairport_metadata_enabled }}";
  include_cover_art = "{{ shairport_effective_metadata_include_cover_art }}";
};

diagnostics = {
  log_verbosity = {{ shairport_log_verbosity | default(1) }};
};
