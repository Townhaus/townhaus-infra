[Unit]
Description=NQPTP timing daemon for Shairport Sync AirPlay 2
After=network.target

[Service]
Type=simple
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_NICE
NoNewPrivileges=yes
ExecStart={{ shairport_airplay2_nqptp_prefix }}/sbin/nqptp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
