# Managed by Ansible. Read/exported by the root rc prestart, never shell arguments.
HUB_URL={{ opnsense_beszel_agent_hub_url | quote }}
KEY={{ opnsense_beszel_agent_hub_key | quote }}
TOKEN={{ opnsense_beszel_agent_token_result.stdout | quote }}
CA_CERT_FILE=/usr/local/etc/beszel-agent/hub-ca.crt
DISABLE_SSH=true
LISTEN=127.0.0.1:45876
DATA_DIR=/var/db/beszel-agent
TMPDIR=/var/run/beszel-agent
NICS={{ opnsense_beszel_agent_nics | quote }}
FILESYSTEM={{ opnsense_beszel_agent_filesystem | quote }}
EXTRA_FILESYSTEMS={{ opnsense_beszel_agent_extra_filesystems | quote }}
DOCKER_HOST=''
DOCKER_IMAGE_CHECK=false
PACKAGE_UPDATES_INTERVAL=0
LOG_LEVEL=info
