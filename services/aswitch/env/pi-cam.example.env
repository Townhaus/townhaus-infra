# Copy to env/pi-cam.env and set real values before deploy.
# pi-cam runs vinyl capture, the DAC status monitor, and the amp trigger relay.

MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=your-user
MQTT_PASS=your-password
LOG_LEVEL=INFO

# Vinyl player -> Yamaha mixer -> Scarlett analogue inputs 3/4.
AUDIO_DEVICE=Scarlett 6i6 USB
AUDIO_CAPTURE_CHANNELS=6
AUDIO_CHANNEL_MAP=3,4
AUDIO_MQTT_TOPIC_PREFIX=pi-cam
AUDIO_ACTIVITY_INACTIVE_HOLD_SECONDS=30
RECORDINGS_DIR=/home/YOUR_USER/aswitch/recordings
RECORDING_ATTENUATION_DB=-6.0
GROOVENET_INGEST_ENABLED=true
GROOVENET_INGEST_URL=https://groovenet.home.arpa/api/audio/ingest
GROOVENET_SOURCE_ID=pi-cam
GROOVENET_CHUNK_SECONDS=15
GROOVENET_SAMPLE_RATE=44100
GROOVENET_SPOOL_DIR=/home/YOUR_USER/aswitch/groovenet-spool
GROOVENET_INGEST_ONLY_WHEN_ACTIVE=true

# dac_status.py
DAC_USB_ID=your-usb-vendor:product-id
DAC_MATCH_TEXT=Your DAC Name
DAC_POLL_INTERVAL_SECONDS=5
DAC_STATE_TOPIC=aswitch/dac/your-dac/state
DAC_DETAILS_TOPIC=aswitch/dac/your-dac/details
DAC_AVAILABILITY_TOPIC=aswitch/dac/your-dac/availability

# amp_trigger.py — BCM GPIO27 is physical header pin 13.
AMP_TRIGGER_GPIO=27
AMP_TRIGGER_COMMAND_TOPIC=pi-cam/trigger
AMP_TRIGGER_STATE_TOPIC=pi-cam/trigger/state
AMP_TRIGGER_AVAILABILITY_TOPIC=pi-cam/availability
