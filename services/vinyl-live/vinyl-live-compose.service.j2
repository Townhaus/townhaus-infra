[Unit]
Description=Vinyl Live Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
PartOf=docker.service
RequiresMountsFor={{ vinyl_live_app_dir }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ vinyl_live_app_dir }}
ExecStart=/usr/bin/docker compose -p vinyl-live {{ '--profile public ' if vinyl_live_tunnel_token_ref | length > 0 else '' }}up -d audio server{{ ' tunnel' if vinyl_live_tunnel_token_ref | length > 0 else '' }}
ExecStop=/usr/bin/docker compose -p vinyl-live {{ '--profile public ' if vinyl_live_tunnel_token_ref | length > 0 else '' }}stop audio server{{ ' tunnel' if vinyl_live_tunnel_token_ref | length > 0 else '' }}
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
