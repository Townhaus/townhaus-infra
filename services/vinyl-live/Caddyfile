{
	admin off
	auto_https off
}

:8081 {
	# Keep the existing listener URLs and health check on the tunnel origin.
	@audio path /pi-cam.mp3 /aswitch.mp3 /healthz
	handle @audio {
		reverse_proxy audio:8081 {
			flush_interval -1
		}
	}

	# Public listeners can read the display, metadata, and artwork. Publishing
	# remains controlled through Home Assistant; no control API is exposed.
	@read method GET HEAD
	handle @read {
		reverse_proxy now-playing:3000 {
			flush_interval -1
		}
	}
	handle {
		respond "Method not allowed" 405
	}
}
