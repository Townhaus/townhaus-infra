# Passwords are stored in 1Password and injected at runtime.
# Each value is injected directly as a string, avoiding JSON escaping issues.
TF_VAR_iot_wifi_password="op://Homelab/UniFi WiFi/iot_password"
TF_VAR_guest_wifi_password="op://Homelab/UniFi WiFi/guest_password"
TF_VAR_haus_wifi_password="op://Homelab/UniFi Haus WiFi/password"
