# direnv: use the Homelab 1Password service account for every `op` call made
# from this repo (Ansible, Terraform, scripts), so the desktop app never shows
# an approval dialog. The token stays outside the repo. Run `direnv allow` once.
# Every op:// reference here is in the Homelab vault, which the service account
# can read; other vaults are not reachable while this is active.
token_file="$HOME/.config/op/homelab-service-account-token"
if [[ -r "$token_file" && -s "$token_file" ]]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$(<"$token_file")"
  export OP_BIOMETRIC_UNLOCK_ENABLED=false
  unset OP_CONNECT_HOST OP_CONNECT_TOKEN
else
  log_status "no Homelab service-account token at $token_file; op will use the desktop app"
fi
