# Optional alternate layout (not recommended for Frigate/HA path handling):
# https://beelink/frigate and https://beelink/groovenet
beelink {
	import common
	handle_path /frigate/* {
		reverse_proxy http://host.docker.internal:5000
	}
	handle_path /groovenet/* {
		reverse_proxy http://{$GROOVENET_UPSTREAM_HOST:webapp}:3000
	}
	respond 404
}

# Optional alternate single-host Home Assistant endpoint:
# https://homeassistant
homeassistant {
	import common
	reverse_proxy http://192.168.2.91:8123
}

# Herdr Web UI on the Mac mini, published as a Caddy vhost there:
# - https://herdr
# - https://herdr.home.arpa
# No longer via Tailscale Serve: it claimed all of :443 on macm4mini's
# tailscale interface, regardless of SNI, which swallowed every other TLS
# connection to that machine (including every groovenet dev worktree vhost).
# macm4mini's own Caddy (tls internal) now owns :443 there exclusively.
#
# herdr-web-ui does its own Origin validation against the Host header it
# sees (see its docs' reverse-proxy section): forwarding a different Host
# than the browser's origin trips "invalid_origin" (403). macm4mini's Caddy
# vhost lists herdr.home.arpa directly for exactly this reason, so the Host
# header can be passed through unchanged -- tls_server_name only picks the
# TLS leg's SNI/cert, independent of the HTTP Host forwarded to the app.
herdr, herdr.home.arpa {
	import common
	reverse_proxy https://100.115.36.23 {
		header_up Host {host}
		transport http {
			tls_server_name herdr.home.arpa
			tls_insecure_skip_verify
		}
	}
}
